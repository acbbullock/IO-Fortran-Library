  ! Reading Procedures ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#:for k, r in COMPLEX_KINDS
#:if k in QUAD_KINDS
#ifdef IOFL_HAS_R128
#:endif
  module procedure from_text_${k}$
    type(String)              :: text_file
    type(String), allocatable :: cells(:,:)
    integer                   :: nrows, ncols
    integer, allocatable      :: cell_stat(:,:)
    logical, allocatable      :: blank(:,:)
    integer                   :: first
    real(${r}$)                 :: nan_part

    nrows=0; ncols=0

    call read_cells(text_file, file, len(im) == 0, cells, NL, delim, stat, errmsg, "text")

    if ( stat /= 0 ) return

    call text_file%empty()

    nrows = size(cells, dim=1); ncols = size(cells, dim=2)

    if ( (nrows == 1) .and. header ) then
      stat   = ARG_ERR
      errmsg = 'Error reading file "'//file//'". File read with one line, but header was specified as present.'
      return
    end if

    if ( present(column_names) ) column_names = cells(1,:)

    select rank(into)
      rank(1)
        if ( ncols > 1 ) then
          stat   = ARG_ERR
          errmsg = 'Error reading file "'//file//'". Data has more than one column but actual argument is a '//&
                   "one-dimensional array. Try reading into a two-dimensional array instead."
          return
        end if
      rank(2)
        continue
    end select

    select rank(into)
      rank(1)
        if ( header ) then
          allocate( into(nrows-1), stat=stat, errmsg=errmsg )
        else
          allocate( into(nrows), stat=stat, errmsg=errmsg )
        end if
      rank(2)
        if ( header ) then
          allocate( into(nrows-1,ncols), stat=stat, errmsg=errmsg )
        else
          allocate( into(nrows,ncols), stat=stat, errmsg=errmsg )
        end if
    end select

    if ( stat /= 0 ) then
      stat = ALLOC_ERR; return
    end if

    allocate( cell_stat(nrows,ncols), source=0, stat=stat, errmsg=errmsg )

    if ( stat /= 0 ) then
      stat = ALLOC_ERR; return
    end if

    select rank(into)
      rank(1)
        if ( header ) then
          call cast(cells(2:,1), into, locale=locale, fmt=fmt, im=im, stat=cell_stat(2:,1))
        else
          call cast(cells(:,1), into, locale=locale, fmt=fmt, im=im, stat=cell_stat(:,1))
        end if
      rank(2)
        if ( header ) then
          call cast(cells(2:,:), into, locale=locale, fmt=fmt, im=im, stat=cell_stat(2:,:))
        else
          call cast(cells, into, locale=locale, fmt=fmt, im=im, stat=cell_stat)
        end if
    end select

    if ( any(cell_stat /= 0) ) then
      nan_part = ieee_value(0e0_${r}$, ieee_quiet_nan)
      blank = is_blank(cells)
      first = 1
      if ( header ) first = 2

      select rank(into)
        rank(1)
          where ( blank(first:,1) ) into = cmplx(nan_part, nan_part, kind=${r}$)
        rank(2)
          where ( blank(first:,:) ) into = cmplx(nan_part, nan_part, kind=${r}$)
      end select

      where ( blank ) cell_stat = 0
    end if

    call report_cells(file, cells, cell_stat, stat, errmsg)
  end procedure from_text_${k}$
#:if k in QUAD_KINDS
#endif
#:endif

#:endfor

#:for k in REAL_KINDS
