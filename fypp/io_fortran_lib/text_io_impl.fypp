  module procedure echo_chars
    character(len=:), allocatable :: ext

    character(len=:), allocatable :: terminator_
    character(len=:), pointer :: errmsg_
    integer, pointer :: stat_
    logical :: append_

    character(len=1024), target :: dummy_msg
    integer,          target :: dummy_stat

    logical :: exists
    integer :: file_unit

    exists=.false.; file_unit=0

    ext = ext_of(file)

    if ( .not. present(stat) ) then
      stat_ => dummy_stat
    else
      stat_ => stat
    end if

    if ( .not. present(errmsg) ) then
      errmsg_ => dummy_msg
    else
      errmsg_ => errmsg
    end if

    stat_=0; errmsg_=EMPTY_STR

    if ( format_of(file, format) /= "text" ) then
      stat_   = ARG_ERR
      errmsg_ = 'Error writing to file "'//file//'" due to unsupported file extension "'//ext//'". '// &
                "Supported file extensions: "//join(TEXT_EXT)
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    append_ = optval(append, APPEND_TO_FILE)

    terminator_ = optval(terminator, LINE_FEED)

    inquire(file=file, exist=exists, iostat=stat_, iomsg=errmsg_)

    if ( stat_ /= 0 ) then
      stat_ = WRITE_ERR
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    file_unit = output_unit

    if ( .not. exists ) then
      open( newunit=file_unit, file=file, status="new", form="unformatted", &
            action="write", access="stream", iostat=stat_, iomsg=errmsg_ )
    else
      if ( .not. append_ ) then
        open( newunit=file_unit, file=file, status="replace", form="unformatted", &
              action="write", access="stream", iostat=stat_, iomsg=errmsg_ )
      else
        open( newunit=file_unit, file=file, status="old", form="unformatted", &
              action="write", access="stream", position="append", iostat=stat_, iomsg=errmsg_ )
      end if
    end if

    if ( stat_ /= 0 ) then
      stat_ = WRITE_ERR
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    write(unit=file_unit, iostat=stat_, iomsg=errmsg_) substring

    if ( stat_ /= 0 ) then
      stat_ = WRITE_ERR
      call close_quietly(file_unit)
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    write(unit=file_unit, iostat=stat_, iomsg=errmsg_) terminator_

    if ( stat_ /= 0 ) then
      stat_ = WRITE_ERR
      call close_quietly(file_unit)
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    close(unit=file_unit, iostat=stat_, iomsg=errmsg_)

    if ( stat_ /= 0 ) then
      stat_ = WRITE_ERR
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    call stop_if_unhandled(stat_, errmsg_, present(stat))
  end procedure echo_chars

  module procedure echo_string
    character(len=:), allocatable :: ext

    character(len=:), allocatable :: terminator_
    character(len=:), pointer :: errmsg_
    integer, pointer :: stat_
    logical :: append_

    character(len=1024), target :: dummy_msg
    integer,          target :: dummy_stat

    logical :: exists
    integer :: file_unit

    exists=.false.; file_unit=0

    ext = ext_of(file)

    if ( .not. present(stat) ) then
      stat_ => dummy_stat
    else
      stat_ => stat
    end if

    if ( .not. present(errmsg) ) then
      errmsg_ => dummy_msg
    else
      errmsg_ => errmsg
    end if

    stat_=0; errmsg_=EMPTY_STR

    if ( format_of(file, format) /= "text" ) then
      stat_   = ARG_ERR
      errmsg_ = 'Error writing to file "'//file//'" due to unsupported file extension "'//ext//'". '// &
                "Supported file extensions: "//join(TEXT_EXT)
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    append_ = optval(append, APPEND_TO_FILE)

    terminator_ = optval(terminator, LINE_FEED)

    inquire(file=file, exist=exists, iostat=stat_, iomsg=errmsg_)

    if ( stat_ /= 0 ) then
      stat_ = WRITE_ERR
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    file_unit = output_unit

    if ( .not. exists ) then
      open( newunit=file_unit, file=file, status="new", form="unformatted", &
            action="write", access="stream", iostat=stat_, iomsg=errmsg_ )
    else
      if ( .not. append_ ) then
        open( newunit=file_unit, file=file, status="replace", form="unformatted", &
              action="write", access="stream", iostat=stat_, iomsg=errmsg_ )
      else
        open( newunit=file_unit, file=file, status="old", form="unformatted", &
              action="write", access="stream", position="append", iostat=stat_, iomsg=errmsg_ )
      end if
    end if

    if ( stat_ /= 0 ) then
      stat_ = WRITE_ERR
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    if ( allocated(substring%buf) ) write(unit=file_unit, iostat=stat_, iomsg=errmsg_) substring%buf(:substring%n)

    if ( stat_ /= 0 ) then
      stat_ = WRITE_ERR
      call close_quietly(file_unit)
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    write(unit=file_unit, iostat=stat_, iomsg=errmsg_) terminator_

    if ( stat_ /= 0 ) then
      stat_ = WRITE_ERR
      call close_quietly(file_unit)
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    close(unit=file_unit, iostat=stat_, iomsg=errmsg_)

    if ( stat_ /= 0 ) then
      stat_ = WRITE_ERR
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    call stop_if_unhandled(stat_, errmsg_, present(stat))
  end procedure echo_string

#:for k, r in COMPLEX_KINDS
#:if k in QUAD_KINDS
