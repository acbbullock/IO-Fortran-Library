  ! Reading Procedures ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#:for k, r in COMPLEX_KINDS
#:if k in QUAD_KINDS
#ifdef IOFL_HAS_R128
#:endif
  module procedure from_textfile_${k}$
    character(len=:), allocatable :: ext

    character(len=:), allocatable :: locale_, delim_, fmt_, im_
    character(len=:), pointer :: errmsg_
    logical :: header_
    integer, pointer :: stat_

    character(len=1024), target :: dummy_msg
    integer,          target :: dummy_stat

    ext = ext_of(file)

    if ( .not. present(stat) ) then
      stat_ => dummy_stat
    else
      stat_ => stat
    end if

    if ( .not. present(errmsg) ) then
      errmsg_ => dummy_msg
    else
      errmsg_ => errmsg
    end if

    stat_=0; errmsg_=EMPTY_STR

    call check_name(file, format, name, .false., stat_, errmsg_)
    if ( stat_ /= 0 ) then
      call stop_if_unhandled(stat_, errmsg_, present(stat)); return
    end if

    if ( format_of(file, format) == "text" ) then
      header_ = optval(header, ABSENT_HEADER)

      if ( present(column_names) ) then
        if ( present(header) .and. (.not. header_) ) then
          stat_   = ARG_ERR
          errmsg_ = 'column_names was given for file "'//file//'" with header=.false.. column_names reads the '// &
                    "header row, so leave header out or set it to .true.."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
        header_ = .true.
      end if

      if ( .not. present(locale) ) then
        locale_ = US_LOCALE
      else
        if ( any(LOCALES == locale) ) then
          locale_ = locale
        else
          stat_   = ARG_ERR
          errmsg_ = 'Invalid locale "'//locale//'" for file "'//file//'". Locale must be one of: '//join(LOCALES)
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
      end if

      if ( .not. present(delim) ) then
        delim_ = default_delim(file, locale_)
      else
        delim_ = delim
        if ( locale_ == US_LOCALE ) then
          if ( delim_ == POINT ) then
            stat_   = ARG_ERR
            errmsg_ = "Invalid delimiter for numbers having US style decimal."
            call stop_if_unhandled(stat_, errmsg_, present(stat))
            return
          end if
        else
          if ( delim_ == COMMA ) then
            stat_   = ARG_ERR
            errmsg_ = "Invalid delimiter for numbers having EU style decimal."
            call stop_if_unhandled(stat_, errmsg_, present(stat))
            return
          end if
        end if
      end if

      if ( .not. present(fmt) ) then
        fmt_ = EXP_FMT
      else
        if ( any(REAL_FMTS == fmt) ) then
          fmt_ = fmt
        else
          stat_   = ARG_ERR
          errmsg_ = 'Invalid format "'//fmt//'" for read of file "'//file//'" '// &
                    "into complex array. Format must be one of: "//join(REAL_FMTS)
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
      end if

      im_ = optval(im, EMPTY_STRING)

      select rank(into)
        rank(1)
          call from_text(file, into, header_, locale_, delim_, fmt_, im_, stat_, errmsg_, column_names=column_names)
        rank(2)
          call from_text(file, into, header_, locale_, delim_, fmt_, im_, stat_, errmsg_, column_names=column_names)
        rank default
          stat_   = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-2."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
      end select
    else if ( is_numpy(file, format) ) then
      if ( present(column_names) ) then
        stat_   = ARG_ERR
        errmsg_ = 'column_names was given for file "'//file//'", but a NumPy file has no header row.'
        call stop_if_unhandled(stat_, errmsg_, present(stat))
        return
      end if

#:if k in QUAD_KINDS
      stat_   = ARG_ERR
      errmsg_ = 'NumPy has no type for real128 data, so "'//file//'" cannot be a NumPy file.'
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
#:else
      if ( present(header) ) write(*,"(a)") LF//'WARNING: header not supported for file type "'//ext//'".'
#:if not k.startswith("i")
      if ( present(locale) ) write(*,"(a)") LF//'WARNING: locale not supported for file type "'//ext//'".'
#:endif
      if ( present(delim ) ) write(*,"(a)") LF//'WARNING: delim not supported for file type "'//ext//'".'
      if ( present(fmt   ) ) write(*,"(a)") LF//'WARNING: fmt not supported for file type "'//ext//'".'
#:if k.startswith("c")
      if ( present(im    ) ) write(*,"(a)") LF//'WARNING: im not supported for file type "'//ext//'".'
#:endif

      select rank(into)
#:for rank in RANKS
        rank(${rank}$); call from_npy(file, into, stat_, errmsg_, format_of(file, format) == "npz", name)
#:endfor
        rank default
          stat_   = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-15."
      end select
#:endif
    else
      stat_   = ARG_ERR
      errmsg_ = 'Unsupported file extension "'//ext//'" for file "'//file//'". Extension must be one of: '// &
                join(TEXT_EXT)//' npy npz. Or pass format="text", format="npy" or format="npz".'
    end if

    call stop_if_unhandled(stat_, errmsg_, present(stat))
  end procedure from_textfile_${k}$
#:if k in QUAD_KINDS
#endif
#:endif

#:endfor

#:for k, r in COMPLEX_KINDS
#:if k in QUAD_KINDS
#ifdef IOFL_HAS_R128
#:endif
  module procedure from_binaryfile_${k}$
    character(len=:), allocatable :: ext
    integer                       :: into_rank

    character(len=:), pointer :: errmsg_
    integer, pointer :: stat_

    character(len=1024), target :: dummy_msg
    integer,          target :: dummy_stat

    ext = ext_of(file)

    if ( .not. present(stat) ) then
      stat_ => dummy_stat
    else
      stat_ => stat
    end if

    if ( .not. present(errmsg) ) then
      errmsg_ => dummy_msg
    else
      errmsg_ => errmsg
    end if

    stat_=0; errmsg_=EMPTY_STR

    call check_name(file, format, name, .false., stat_, errmsg_)
    if ( stat_ /= 0 ) then
      call stop_if_unhandled(stat_, errmsg_, present(stat)); return
    end if

    select rank(into)
#:for rank in RANKS
      rank(${rank}$); into_rank = ${rank}$
#:endfor
      rank default; into_rank = -1
    end select

    if ( size(data_shape) /= into_rank ) then
      stat_   = ARG_ERR
      errmsg_ = "RANK/SHAPE mismatch: size of data_shape must match rank of output array."
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    if ( is_numpy(file, format) ) then
#:if k in QUAD_KINDS
      stat_   = ARG_ERR
      errmsg_ = 'NumPy has no type for real128 data, so "'//file//'" cannot be a NumPy file.'
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
#:else
      select rank(into)
#:for rank in RANKS
        rank(${rank}$)
          call from_npy(file, into, stat_, errmsg_, format_of(file, format) == "npz", name)
          if ( stat_ == 0 ) then
            if ( any(shape(into) /= data_shape) ) then
              stat_   = READ_ERR
              errmsg_ = 'Error reading file "'//file//'": its shape differs from data_shape.'
            end if
          end if
#:endfor
      end select
#:endif
    else if ( format_of(file, format) == "binary" ) then
      select rank(into)
#:for rank in RANKS
        rank(${rank}$)
          call from_binary(file, into, data_shape, stat_, errmsg_)
#:endfor
        rank default
          stat_  = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-15."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
      end select
    else
      stat_   = ARG_ERR
      errmsg_ = 'Error reading file "'//file//'" with extension "'//ext//'". '// &
                "If attempting to read a text file, the data_shape argument must not be specified."// &
                "If attempting to read a binary file, the supported file extensions are: "//join(BINARY_EXT)
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    call stop_if_unhandled(stat_, errmsg_, present(stat))
  end procedure from_binaryfile_${k}$
#:if k in QUAD_KINDS
#endif
#:endif

#:endfor

#:for k in REAL_KINDS
#:if k in QUAD_KINDS
#ifdef IOFL_HAS_R128
#:endif
  module procedure from_textfile_${k}$
    character(len=:), allocatable :: ext

    character(len=:), allocatable :: locale_, delim_, fmt_
    character(len=:), pointer :: errmsg_
    logical :: header_
    integer, pointer :: stat_

    character(len=1024), target :: dummy_msg
    integer,          target :: dummy_stat

    ext = ext_of(file)

    if ( .not. present(stat) ) then
      stat_ => dummy_stat
    else
      stat_ => stat
    end if

    if ( .not. present(errmsg) ) then
      errmsg_ => dummy_msg
    else
      errmsg_ => errmsg
    end if

    stat_=0; errmsg_=EMPTY_STR

    call check_name(file, format, name, .false., stat_, errmsg_)
    if ( stat_ /= 0 ) then
      call stop_if_unhandled(stat_, errmsg_, present(stat)); return
    end if

    if ( format_of(file, format) == "text" ) then
      header_ = optval(header, ABSENT_HEADER)

      if ( present(column_names) ) then
        if ( present(header) .and. (.not. header_) ) then
          stat_   = ARG_ERR
          errmsg_ = 'column_names was given for file "'//file//'" with header=.false.. column_names reads the '// &
                    "header row, so leave header out or set it to .true.."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
        header_ = .true.
      end if

      if ( .not. present(locale) ) then
        locale_ = US_LOCALE
      else
        if ( any(LOCALES == locale) ) then
          locale_ = locale
        else
          stat_   = ARG_ERR
          errmsg_ = 'Invalid locale "'//locale//'" for file "'//file//'". Locale must be one of: '//join(LOCALES)
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
      end if

      if ( .not. present(delim) ) then
        delim_ = default_delim(file, locale_)
      else
        delim_ = delim
        if ( locale_ == US_LOCALE ) then
          if ( delim_ == POINT ) then
            stat_   = ARG_ERR
            errmsg_ = "Invalid delimiter for numbers having US style decimal."
            call stop_if_unhandled(stat_, errmsg_, present(stat))
            return
          end if
        else
          if ( delim_ == COMMA ) then
            stat_   = ARG_ERR
            errmsg_ = "Invalid delimiter for numbers having EU style decimal."
            call stop_if_unhandled(stat_, errmsg_, present(stat))
            return
          end if
        end if
      end if

      if ( .not. present(fmt) ) then
        fmt_ = EXP_FMT
      else
        if ( any(REAL_FMTS == fmt) ) then
          fmt_ = fmt
        else
          stat_   = ARG_ERR
          errmsg_ = 'Invalid format "'//fmt//'" for read of file "'//file//'" '// &
                    "into real array. Format must be one of: "//join(REAL_FMTS)
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
      end if

      select rank(into)
        rank(1)
          call from_text(file, into, header_, locale_, delim_, fmt_, stat_, errmsg_, column_names=column_names)
        rank(2)
          call from_text(file, into, header_, locale_, delim_, fmt_, stat_, errmsg_, column_names=column_names)
        rank default
          stat_   = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-2."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
      end select
    else if ( is_numpy(file, format) ) then
      if ( present(column_names) ) then
        stat_   = ARG_ERR
        errmsg_ = 'column_names was given for file "'//file//'", but a NumPy file has no header row.'
        call stop_if_unhandled(stat_, errmsg_, present(stat))
        return
      end if

#:if k in QUAD_KINDS
      stat_   = ARG_ERR
      errmsg_ = 'NumPy has no type for real128 data, so "'//file//'" cannot be a NumPy file.'
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
#:else
      if ( present(header) ) write(*,"(a)") LF//'WARNING: header not supported for file type "'//ext//'".'
#:if not k.startswith("i")
      if ( present(locale) ) write(*,"(a)") LF//'WARNING: locale not supported for file type "'//ext//'".'
#:endif
      if ( present(delim ) ) write(*,"(a)") LF//'WARNING: delim not supported for file type "'//ext//'".'
      if ( present(fmt   ) ) write(*,"(a)") LF//'WARNING: fmt not supported for file type "'//ext//'".'
#:if k.startswith("c")
      if ( present(im    ) ) write(*,"(a)") LF//'WARNING: im not supported for file type "'//ext//'".'
#:endif

      select rank(into)
#:for rank in RANKS
        rank(${rank}$); call from_npy(file, into, stat_, errmsg_, format_of(file, format) == "npz", name)
#:endfor
        rank default
          stat_   = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-15."
      end select
#:endif
    else
      stat_   = ARG_ERR
      errmsg_ = 'Unsupported file extension "'//ext//'" for file "'//file//'". Extension must be one of: '// &
                join(TEXT_EXT)//' npy npz. Or pass format="text", format="npy" or format="npz".'
    end if

    call stop_if_unhandled(stat_, errmsg_, present(stat))
  end procedure from_textfile_${k}$
#:if k in QUAD_KINDS
#endif
#:endif

#:endfor

#:for k in REAL_KINDS
#:if k in QUAD_KINDS
#ifdef IOFL_HAS_R128
#:endif
  module procedure from_binaryfile_${k}$
    character(len=:), allocatable :: ext
    integer                       :: into_rank

    character(len=:), pointer :: errmsg_
    integer, pointer :: stat_

    character(len=1024), target :: dummy_msg
    integer,          target :: dummy_stat

    ext = ext_of(file)

    if ( .not. present(stat) ) then
      stat_ => dummy_stat
    else
      stat_ => stat
    end if

    if ( .not. present(errmsg) ) then
      errmsg_ => dummy_msg
    else
      errmsg_ => errmsg
    end if

    stat_=0; errmsg_=EMPTY_STR

    call check_name(file, format, name, .false., stat_, errmsg_)
    if ( stat_ /= 0 ) then
      call stop_if_unhandled(stat_, errmsg_, present(stat)); return
    end if

    select rank(into)
#:for rank in RANKS
      rank(${rank}$); into_rank = ${rank}$
#:endfor
      rank default; into_rank = -1
    end select

    if ( size(data_shape) /= into_rank ) then
      stat_   = ARG_ERR
      errmsg_ = "RANK/SHAPE mismatch: size of data_shape must match rank of output array."
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    if ( is_numpy(file, format) ) then
#:if k in QUAD_KINDS
      stat_   = ARG_ERR
      errmsg_ = 'NumPy has no type for real128 data, so "'//file//'" cannot be a NumPy file.'
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
#:else
      select rank(into)
#:for rank in RANKS
        rank(${rank}$)
          call from_npy(file, into, stat_, errmsg_, format_of(file, format) == "npz", name)
          if ( stat_ == 0 ) then
            if ( any(shape(into) /= data_shape) ) then
              stat_   = READ_ERR
              errmsg_ = 'Error reading file "'//file//'": its shape differs from data_shape.'
            end if
          end if
#:endfor
      end select
#:endif
    else if ( format_of(file, format) == "binary" ) then
      select rank(into)
#:for rank in RANKS
        rank(${rank}$)
          call from_binary(file, into, data_shape, stat_, errmsg_)
#:endfor
        rank default
          stat_  = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-15."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
      end select
    else
      stat_   = ARG_ERR
      errmsg_ = 'Error reading file "'//file//'" with extension "'//ext//'". '// &
                "If attempting to read a text file, the data_shape argument must not be specified."// &
                "If attempting to read a binary file, the supported file extensions are: "//join(BINARY_EXT)
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    call stop_if_unhandled(stat_, errmsg_, present(stat))
  end procedure from_binaryfile_${k}$
#:if k in QUAD_KINDS
#endif
#:endif

#:endfor

#:for k in INT_KINDS
  module procedure from_textfile_${k}$
    character(len=:), allocatable :: ext

    character(len=:), allocatable :: delim_, fmt_
    character(len=:), pointer :: errmsg_
    logical :: header_
    integer, pointer :: stat_

    character(len=1024), target :: dummy_msg
    integer,          target :: dummy_stat

    ext = ext_of(file)

    if ( .not. present(stat) ) then
      stat_ => dummy_stat
    else
      stat_ => stat
    end if

    if ( .not. present(errmsg) ) then
      errmsg_ => dummy_msg
    else
      errmsg_ => errmsg
    end if

    stat_=0; errmsg_=EMPTY_STR

    call check_name(file, format, name, .false., stat_, errmsg_)
    if ( stat_ /= 0 ) then
      call stop_if_unhandled(stat_, errmsg_, present(stat)); return
    end if

    if ( format_of(file, format) == "text" ) then
      header_ = optval(header, ABSENT_HEADER)

      if ( present(column_names) ) then
        if ( present(header) .and. (.not. header_) ) then
          stat_   = ARG_ERR
          errmsg_ = 'column_names was given for file "'//file//'" with header=.false.. column_names reads the '// &
                    "header row, so leave header out or set it to .true.."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
        header_ = .true.
      end if

      delim_ = optval(delim, default_delim(file, US_LOCALE))

      if ( .not. present(fmt) ) then
        fmt_ = INT_FMT
      else
        if ( any(INT_FMTS == fmt) ) then
          fmt_ = fmt
        else
          stat_   = ARG_ERR
          errmsg_ = 'Invalid format "'//fmt//'" for read of file "'//file//'" '// &
                    "into integer array. Format must be one of: "//join(INT_FMTS)
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
      end if

      select rank(into)
        rank(1)
          call from_text(file, into, header_, delim_, fmt_, stat_, errmsg_, column_names=column_names)
        rank(2)
          call from_text(file, into, header_, delim_, fmt_, stat_, errmsg_, column_names=column_names)
        rank default
          stat_   = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-2."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
      end select
    else if ( is_numpy(file, format) ) then
      if ( present(column_names) ) then
        stat_   = ARG_ERR
        errmsg_ = 'column_names was given for file "'//file//'", but a NumPy file has no header row.'
        call stop_if_unhandled(stat_, errmsg_, present(stat))
        return
      end if

#:if k in QUAD_KINDS
      stat_   = ARG_ERR
      errmsg_ = 'NumPy has no type for real128 data, so "'//file//'" cannot be a NumPy file.'
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
#:else
      if ( present(header) ) write(*,"(a)") LF//'WARNING: header not supported for file type "'//ext//'".'
#:if not k.startswith("i")
      if ( present(locale) ) write(*,"(a)") LF//'WARNING: locale not supported for file type "'//ext//'".'
#:endif
      if ( present(delim ) ) write(*,"(a)") LF//'WARNING: delim not supported for file type "'//ext//'".'
      if ( present(fmt   ) ) write(*,"(a)") LF//'WARNING: fmt not supported for file type "'//ext//'".'
#:if k.startswith("c")
      if ( present(im    ) ) write(*,"(a)") LF//'WARNING: im not supported for file type "'//ext//'".'
#:endif

      select rank(into)
#:for rank in RANKS
        rank(${rank}$); call from_npy(file, into, stat_, errmsg_, format_of(file, format) == "npz", name)
#:endfor
        rank default
          stat_   = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-15."
      end select
#:endif
    else
      stat_   = ARG_ERR
      errmsg_ = 'Unsupported file extension "'//ext//'" for file "'//file//'". Extension must be one of: '// &
                join(TEXT_EXT)//' npy npz. Or pass format="text", format="npy" or format="npz".'
    end if

    call stop_if_unhandled(stat_, errmsg_, present(stat))
  end procedure from_textfile_${k}$

#:endfor

#:for k in INT_KINDS
  module procedure from_binaryfile_${k}$
    character(len=:), allocatable :: ext
    integer                       :: into_rank

    character(len=:), pointer :: errmsg_
    integer, pointer :: stat_

    character(len=1024), target :: dummy_msg
    integer,          target :: dummy_stat

    ext = ext_of(file)

    if ( .not. present(stat) ) then
      stat_ => dummy_stat
    else
      stat_ => stat
    end if

    if ( .not. present(errmsg) ) then
      errmsg_ => dummy_msg
    else
      errmsg_ => errmsg
    end if

    stat_=0; errmsg_=EMPTY_STR

    call check_name(file, format, name, .false., stat_, errmsg_)
    if ( stat_ /= 0 ) then
      call stop_if_unhandled(stat_, errmsg_, present(stat)); return
    end if

    select rank(into)
#:for rank in RANKS
      rank(${rank}$); into_rank = ${rank}$
#:endfor
      rank default; into_rank = -1
    end select

    if ( size(data_shape) /= into_rank ) then
      stat_   = ARG_ERR
      errmsg_ = "RANK/SHAPE mismatch: size of data_shape must match rank of output array."
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    if ( is_numpy(file, format) ) then
#:if k in QUAD_KINDS
      stat_   = ARG_ERR
      errmsg_ = 'NumPy has no type for real128 data, so "'//file//'" cannot be a NumPy file.'
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
#:else
      select rank(into)
#:for rank in RANKS
        rank(${rank}$)
          call from_npy(file, into, stat_, errmsg_, format_of(file, format) == "npz", name)
          if ( stat_ == 0 ) then
            if ( any(shape(into) /= data_shape) ) then
              stat_   = READ_ERR
              errmsg_ = 'Error reading file "'//file//'": its shape differs from data_shape.'
            end if
          end if
#:endfor
      end select
#:endif
    else if ( format_of(file, format) == "binary" ) then
      select rank(into)
#:for rank in RANKS
        rank(${rank}$)
          call from_binary(file, into, data_shape, stat_, errmsg_)
#:endfor
        rank default
          stat_  = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-15."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
      end select
    else
      stat_   = ARG_ERR
      errmsg_ = 'Error reading file "'//file//'" with extension "'//ext//'". '// &
                "If attempting to read a text file, the data_shape argument must not be specified."// &
                "If attempting to read a binary file, the supported file extensions are: "//join(BINARY_EXT)
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    call stop_if_unhandled(stat_, errmsg_, present(stat))
  end procedure from_binaryfile_${k}$

#:endfor
  ! Logical and text data ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#:for t in ["logical", "string", "chars"]
  module procedure to_file_${t}$
    character(len=:), allocatable :: ext, delim_
#:if t == "logical"
    character(len=:), allocatable :: true_, false_
#:endif
    character(len=:), pointer     :: errmsg_
    integer,          pointer     :: stat_
    type(String)                  :: text_file
    type(String),     allocatable :: cells(:,:)
    integer                       :: nrows, ncols, first, i, j

    character(len=1024), target :: dummy_msg
    integer,             target :: dummy_stat

    ext = ext_of(file)

    if ( .not. present(stat) ) then
      stat_ => dummy_stat
    else
      stat_ => stat
    end if

    if ( .not. present(errmsg) ) then
      errmsg_ => dummy_msg
    else
      errmsg_ => errmsg
    end if

    stat_=0; errmsg_=EMPTY_STR; nrows=0; ncols=0
#:if t == "logical"
    call check_name(file, format, name, .true., stat_, errmsg_)
    if ( stat_ /= 0 ) then
      call stop_if_unhandled(stat_, errmsg_, present(stat)); return
    end if
#:endif

    if ( format_of(file, format) == "text" ) then
      select rank(x)
        rank(1); nrows = size(x); ncols = 1
        rank(2); nrows = size(x, dim=1); ncols = size(x, dim=2)
        rank default
          stat_   = ARG_ERR
          errmsg_ = "Cannot write an array of rank "//str(rank(x))//" to text file."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
      end select

      if ( present(header) ) then
        if ( (size(header) /= 1) .and. (size(header) /= ncols) ) then
          stat_   = ARG_ERR
          errmsg_ = 'Invalid header for file "'//file//'". Header for this data must have size 1 or size '// &
                    str(ncols)//"."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
      end if

      delim_ = optval(delim, default_delim(file, US_LOCALE))

#:if t == "logical"
      true_ = "T"; false_ = "F"
      if ( present(fmt) ) then
        if ( fmt == "bit" ) then
          true_ = "1"; false_ = "0"
        else if ( fmt /= "tf" ) then
          stat_   = ARG_ERR
          errmsg_ = 'Invalid format "'//fmt//'" for file "'//file//'". Format for logical data must be "tf" or "bit".'
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
      end if

#:endif
      select rank(x)
        rank(1); call header_cells(nrows, ncols, .false., header, cells, first, stat_, errmsg_)
        rank(2); call header_cells(nrows, ncols, .true., header, cells, first, stat_, errmsg_)
      end select

      if ( stat_ == 0 ) then
        select rank(x)
          rank(1)
            do i = 1, nrows
#:if t == "logical"
              cells(first+i-1,1)%buf = merge(true_, false_, x(i))
#:elif t == "string"
              cells(first+i-1,1) = x(i)
#:else
              cells(first+i-1,1)%buf = trim(x(i))
#:endif
            end do
          rank(2)
            do j = 1, ncols
              do i = 1, nrows
#:if t == "logical"
                cells(first+i-1,j)%buf = merge(true_, false_, x(i,j))
#:elif t == "string"
                cells(first+i-1,j) = x(i,j)
#:else
                cells(first+i-1,j)%buf = trim(x(i,j))
#:endif
              end do
            end do
        end select
#:if t != "string"

        do j = 1, ncols
          do i = first, size(cells, dim=1)
            cells(i,j)%n = len(cells(i,j)%buf, kind=i64)
          end do
        end do
#:endif

        call write_cells(text_file, .false., cells, file, NL, delim_, .false., stat_, errmsg_, "text")
      end if
#:if t == "logical"
    else if ( is_numpy(file, format) ) then
      if ( present(header) ) write(*,"(a)") LF//'WARNING: header not supported for file type "'//ext//'".'
      if ( present(delim ) ) write(*,"(a)") LF//'WARNING: delim not supported for file type "'//ext//'".'
      if ( present(fmt   ) ) write(*,"(a)") LF//'WARNING: fmt not supported for file type "'//ext//'".'

      select rank(x)
#:for rank in RANKS
        rank(${rank}$); call to_npy(x, file, stat_, errmsg_, format_of(file, format) == "npz", name)
#:endfor
        rank default
          stat_   = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-15."
      end select
    else if ( format_of(file, format) == "binary" ) then
      stat_   = ARG_ERR
      errmsg_ = 'Cannot write logical data to the raw binary file "'//file//'": compilers store logical values '// &
                "differently, so the file could not be read back reliably. Use a NumPy file or a text file."
#:else
    else if ( (format_of(file, format) == "binary") .or. is_numpy(file, format) ) then
      stat_   = ARG_ERR
      errmsg_ = 'Cannot write text data to the file "'//file//'": it can only be written to a text file.'
#:endif
    else
      stat_   = ARG_ERR
      errmsg_ = 'Unsupported file extension "'//ext//'" for file "'//file//'". Extension must be one of: '// &
                join(TEXT_EXT)//SPACE//join(BINARY_EXT)//' npy npz. '// &
                'Or pass format="text", format="binary", format="npy" or format="npz".'
    end if

    call stop_if_unhandled(stat_, errmsg_, present(stat))
  end procedure to_file_${t}$

#:endfor
  module procedure from_textfile_logical
    character(len=:), allocatable :: ext, delim_
    character(len=:), allocatable :: fmt_
    character(len=:), pointer     :: errmsg_
    integer,          pointer     :: stat_
    type(String)                  :: text_file
    type(String),     allocatable :: cells(:,:)
    logical                       :: header_
    integer                       :: nrows, ncols, first

    character(len=1024), target :: dummy_msg
    integer,             target :: dummy_stat

    ext = ext_of(file)

    if ( .not. present(stat) ) then
      stat_ => dummy_stat
    else
      stat_ => stat
    end if

    if ( .not. present(errmsg) ) then
      errmsg_ => dummy_msg
    else
      errmsg_ => errmsg
    end if

    stat_=0; errmsg_=EMPTY_STR

    call check_name(file, format, name, .false., stat_, errmsg_)
    if ( stat_ /= 0 ) then
      call stop_if_unhandled(stat_, errmsg_, present(stat)); return
    end if

    if ( format_of(file, format) == "text" ) then
      header_ = optval(header, ABSENT_HEADER)

      if ( present(column_names) ) then
        if ( present(header) .and. (.not. header_) ) then
          stat_   = ARG_ERR
          errmsg_ = 'column_names was given for file "'//file//'" with header=.false.. column_names reads the '// &
                    "header row, so leave header out or set it to .true.."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
        header_ = .true.
      end if

      delim_ = optval(delim, default_delim(file, US_LOCALE))

      fmt_ = "tf"
      if ( present(fmt) ) then
        if ( (fmt /= "tf") .and. (fmt /= "bit") ) then
          stat_   = ARG_ERR
          errmsg_ = 'Invalid format "'//fmt//'" for file "'//file//'". Format for logical data must be "tf" or "bit".'
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
        fmt_ = fmt
      end if

      select rank(into)
        rank(1); continue
        rank(2); continue
        rank default
          stat_   = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-2."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
      end select

      call read_cells(text_file, file, .false., cells, NL, delim_, stat_, errmsg_, "text")

      if ( stat_ == 0 ) then
        nrows = size(cells, dim=1); ncols = size(cells, dim=2)
        first = 1
        if ( header_ ) first = 2

        if ( (nrows == 1) .and. header_ ) then
          stat_   = ARG_ERR
          errmsg_ = 'Error reading file "'//file//'". File read with one line, but header was specified as present.'
        end if
      end if

      if ( stat_ == 0 ) then
        if ( present(column_names) ) column_names = cells(1,:)

        select rank(into)
          rank(1)
            if ( ncols > 1 ) then
              stat_   = ARG_ERR
              errmsg_ = 'Error reading file "'//file//'". Data has more than one column but actual argument is '// &
                        "a one-dimensional array. Try reading into a two-dimensional array instead."
            else
              allocate( into(nrows-first+1), stat=stat_, errmsg=errmsg_ )
              if ( stat_ == 0 ) call cells_to_logical(cells(first:,:), fmt_, file, first, into, stat_, errmsg_)
            end if
          rank(2)
            allocate( into(nrows-first+1,ncols), stat=stat_, errmsg=errmsg_ )
            if ( stat_ == 0 ) call cells_to_logical(cells(first:,:), fmt_, file, first, into, stat_, errmsg_)
        end select
      end if
    else if ( is_numpy(file, format) ) then
      if ( present(column_names) ) then
        stat_   = ARG_ERR
        errmsg_ = 'column_names was given for file "'//file//'", but a NumPy file has no header row.'
        call stop_if_unhandled(stat_, errmsg_, present(stat))
        return
      end if

      if ( present(header) ) write(*,"(a)") LF//'WARNING: header not supported for file type "'//ext//'".'
      if ( present(delim ) ) write(*,"(a)") LF//'WARNING: delim not supported for file type "'//ext//'".'
      if ( present(fmt   ) ) write(*,"(a)") LF//'WARNING: fmt not supported for file type "'//ext//'".'

      select rank(into)
#:for rank in RANKS
        rank(${rank}$); call from_npy(file, into, stat_, errmsg_, format_of(file, format) == "npz", name)
#:endfor
        rank default
          stat_   = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-15."
      end select
    else if ( format_of(file, format) == "binary" ) then
      stat_   = ARG_ERR
      errmsg_ = 'Cannot read logical data from the raw binary file "'//file//'": compilers store logical values '// &
                "differently. Use a NumPy file or a text file."
    else
      stat_   = ARG_ERR
      errmsg_ = 'Unsupported file extension "'//ext//'" for file "'//file//'". Extension must be one of: '// &
                join(TEXT_EXT)//SPACE//join(BINARY_EXT)//' npy npz. '// &
                'Or pass format="text", format="binary", format="npy" or format="npz".'
    end if

    call stop_if_unhandled(stat_, errmsg_, present(stat))
  end procedure from_textfile_logical

#:for r in [1, 2]
  module procedure from_textfile_string_${r}$
    character(len=:), allocatable :: ext, delim_
    character(len=:), pointer     :: errmsg_
    integer,          pointer     :: stat_
    type(String)                  :: text_file
    type(String),     allocatable :: cells(:,:)
    logical                       :: header_
    integer                       :: nrows, ncols, first, i
#:if r == 2
    integer                       :: j
#:endif

    character(len=1024), target :: dummy_msg
    integer,             target :: dummy_stat

    ext = ext_of(file)

    if ( .not. present(stat) ) then
      stat_ => dummy_stat
    else
      stat_ => stat
    end if

    if ( .not. present(errmsg) ) then
      errmsg_ => dummy_msg
    else
      errmsg_ => errmsg
    end if

    stat_=0; errmsg_=EMPTY_STR

    if ( format_of(file, format) == "text" ) then
      header_ = optval(header, ABSENT_HEADER)

      if ( present(column_names) ) then
        if ( present(header) .and. (.not. header_) ) then
          stat_   = ARG_ERR
          errmsg_ = 'column_names was given for file "'//file//'" with header=.false.. column_names reads the '// &
                    "header row, so leave header out or set it to .true.."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
        header_ = .true.
      end if

      delim_ = optval(delim, default_delim(file, US_LOCALE))

      call read_cells(text_file, file, .false., cells, NL, delim_, stat_, errmsg_, "text")

      if ( stat_ == 0 ) then
        nrows = size(cells, dim=1); ncols = size(cells, dim=2)
        first = 1
        if ( header_ ) first = 2

        if ( (nrows == 1) .and. header_ ) then
          stat_   = ARG_ERR
          errmsg_ = 'Error reading file "'//file//'". File read with one line, but header was specified as present.'
        end if
      end if

      if ( stat_ == 0 ) then
        if ( present(column_names) ) column_names = cells(1,:)
#:if r == 1

        if ( ncols > 1 ) then
          stat_   = ARG_ERR
          errmsg_ = 'Error reading file "'//file//'". Data has more than one column but actual argument is '// &
                    "a one-dimensional array. Try reading into a two-dimensional array instead."
        else
          allocate( into(nrows-first+1), stat=stat_, errmsg=errmsg_ )
          if ( stat_ == 0 ) then
            do i = 1, size(into)
              into(i) = cells(first+i-1,1)
            end do
          end if
        end if
#:else

        allocate( into(nrows-first+1,ncols), stat=stat_, errmsg=errmsg_ )
        if ( stat_ == 0 ) then
          do j = 1, ncols
            do i = 1, size(into, dim=1)
              into(i,j) = cells(first+i-1,j)
            end do
          end do
        end if
#:endif
        if ( stat_ /= 0 ) stat_ = ALLOC_ERR
      end if
    else if ( (format_of(file, format) == "binary") .or. is_numpy(file, format) ) then
      stat_   = ARG_ERR
      errmsg_ = 'Cannot read the file "'//file//'" into String data, which can only be read from a text file.'
    else
      stat_   = ARG_ERR
      errmsg_ = 'Unsupported file extension "'//ext//'" for file "'//file//'". Extension must be one of: '// &
                join(TEXT_EXT)//SPACE//join(BINARY_EXT)//' npy npz. '// &
                'Or pass format="text", format="binary", format="npy" or format="npz".'
    end if

    call stop_if_unhandled(stat_, errmsg_, present(stat))
  end procedure from_textfile_string_${r}$

#:endfor
  pure logical function is_numpy(file, format)
    !! Whether `file` is a NumPy `.npy` file or `.npz` archive.
    character(len=*), intent(in)           :: file
    character(len=*), intent(in), optional :: format

    is_numpy = any([ "npy", "npz" ] == format_of(file, format))
  end function is_numpy

  subroutine check_name(file, format, name, writing, stat, errmsg)
    !! Checks `name`, which names an array in a `.npz` archive: it is only for an archive, it can't be blank, and
    !! writing to an archive needs it.
    character(len=*), intent(in)           :: file
    character(len=*), intent(in), optional :: format, name
    logical,          intent(in)           :: writing
    integer,          intent(out)          :: stat
    character(len=*), intent(out)          :: errmsg

    stat = 0

    if ( present(name) ) then
      if ( format_of(file, format) /= "npz" ) then
        stat   = ARG_ERR
        errmsg = 'name was given for file "'//file//'", but only a .npz file holds arrays by name.'
      else if ( len_trim(name) == 0 ) then
        stat   = ARG_ERR
        errmsg = 'A blank name was given for file "'//file//'". An array in a .npz file needs a name.'
      end if
    else if ( writing .and. (format_of(file, format) == "npz") ) then
      stat   = ARG_ERR
      errmsg = 'No name was given for file "'//file//'". Pass name to say what to call the array in the .npz file.'
    end if
  end subroutine check_name

  subroutine header_cells(nrows, ncols, numbered, header, cells, first, stat, errmsg)
    !! Allocates `cells` for `nrows` rows of data under the header row, if `header` gives one, and fills that row the
    !! way to_file does for numbers: one name per column, or for a two-dimensional array (`numbered`), one name
    !! numbered for each column.
    integer,          intent(in)                         :: nrows, ncols
    logical,          intent(in)                         :: numbered
    character(len=*), intent(in),  optional              :: header(:)
    type(String),     intent(out), allocatable           :: cells(:,:)
    integer,          intent(out)                        :: first, stat
    character(len=*), intent(inout)                      :: errmsg

    integer :: j

    first = 1
    if ( present(header) ) then
      if ( len(header) /= 0 ) first = 2
    end if

    allocate( cells(nrows+first-1,ncols), stat=stat, errmsg=errmsg )

    if ( stat /= 0 ) then
      stat = ALLOC_ERR; return
    end if

    if ( first == 2 ) then
      do j = 1, ncols
        if ( (size(header) == 1) .and. numbered ) then
          cells(1,j)%buf = trim(header(1))//str(j)
        else if ( size(header) == 1 ) then
          cells(1,j)%buf = trim(header(1))
        else
          cells(1,j)%buf = trim(header(j))
        end if
        cells(1,j)%n = len(cells(1,j)%buf, kind=i64)
      end do
    end if
  end subroutine header_cells

  subroutine cells_to_logical(cells, fmt, file, first, into, stat, errmsg)
    !! Reads `cells` into `into`: T or F as list-directed input reads them, or 1 and 0 for `fmt="bit"`. `first` is the
    !! file row of the first cell, for the error message.
    type(String),     intent(in)    :: cells(:,:)
    character(len=*), intent(in)    :: fmt, file
    integer,          intent(in)    :: first
    logical,          intent(inout) :: into(..)
    integer,          intent(out)   :: stat
    character(len=*), intent(inout) :: errmsg

    integer :: i, j, code

    stat = 0

    do j = 1, size(cells, dim=2)
      do i = 1, size(cells, dim=1)
        code = logical_code(cells(i,j)%as_str(), fmt)

        if ( code < 0 ) then
          stat   = READ_ERR
          errmsg = 'Error reading file "'//file//'". Invalid logical value "'//cells(i,j)%as_str()// &
                   '" at row '//str(first+i-1)//", column "//str(j)//"."
          return
        end if

        select rank(into)
          rank(1); into(i)   = (code == 1)
          rank(2); into(i,j) = (code == 1)
        end select
      end do
    end do
  end subroutine cells_to_logical

  pure integer function logical_code(text, fmt) result(code)
    !! 1 for true, 0 for false, and -1 if `text` is neither. With `fmt="tf"`, like list-directed input, the value is the
    !! first letter, T or F in either case, after any blanks and an optional period, so T, .true. and False all read.
    !! With `fmt="bit"`, it is 1 or 0, with any surrounding blanks.
    character(len=*), intent(in) :: text, fmt

    integer :: first, last

    code  = -1
    first = verify(text, SPACE//TAB)
    if ( first == 0 ) return
    last  = verify(text, SPACE//TAB, back=.true.)

    if ( fmt == "bit" ) then
      if ( text(first:last) == "1" ) code = 1
      if ( text(first:last) == "0" ) code = 0
      return
    end if

    if ( (text(first:first) == POINT) .and. (first < last) ) first = first + 1

    select case ( text(first:first) )
      case ("T", "t"); code = 1
      case ("F", "f"); code = 0
    end select
  end function logical_code
end submodule io_file
