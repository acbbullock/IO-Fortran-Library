  ! Reading Procedures ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#:for k, r in COMPLEX_KINDS
#:if k in QUAD_KINDS
#ifdef IOFL_HAS_R128
#:endif
  module procedure from_textfile_${k}$
    character(len=:), allocatable :: ext

    character(len=:), allocatable :: locale_, delim_, fmt_, im_
    character(len=:), pointer :: errmsg_
    logical :: header_
    integer, pointer :: stat_

    character(len=1024), target :: dummy_msg
    integer,          target :: dummy_stat

    ext = ext_of(file)

    if ( .not. present(stat) ) then
      stat_ => dummy_stat
    else
      stat_ => stat
    end if

    if ( .not. present(errmsg) ) then
      errmsg_ => dummy_msg
    else
      errmsg_ => errmsg
    end if

    stat_=0; errmsg_=EMPTY_STR

    if ( format_of(file, format) == "text" ) then
      header_ = optval(header, ABSENT_HEADER)

      if ( present(column_names) ) then
        if ( present(header) .and. (.not. header_) ) then
          stat_   = ARG_ERR
          errmsg_ = 'column_names was given for file "'//file//'" with header=.false.. column_names reads the '// &
                    "header row, so leave header out or set it to .true.."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
        header_ = .true.
      end if

      if ( .not. present(locale) ) then
        locale_ = US_LOCALE
      else
        if ( any(LOCALES == locale) ) then
          locale_ = locale
        else
          stat_   = ARG_ERR
          errmsg_ = 'Invalid locale "'//locale//'" for file "'//file//'". Locale must be one of: '//join(LOCALES)
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
      end if

      if ( .not. present(delim) ) then
        delim_ = default_delim(file, locale_)
      else
        delim_ = delim
        if ( locale_ == US_LOCALE ) then
          if ( delim_ == POINT ) then
            stat_   = ARG_ERR
            errmsg_ = "Invalid delimiter for numbers having US style decimal."
            call stop_if_unhandled(stat_, errmsg_, present(stat))
            return
          end if
        else
          if ( delim_ == COMMA ) then
            stat_   = ARG_ERR
            errmsg_ = "Invalid delimiter for numbers having EU style decimal."
            call stop_if_unhandled(stat_, errmsg_, present(stat))
            return
          end if
        end if
      end if

      if ( .not. present(fmt) ) then
        fmt_ = EXP_FMT
      else
        if ( any(REAL_FMTS == fmt) ) then
          fmt_ = fmt
        else
          stat_   = ARG_ERR
          errmsg_ = 'Invalid format "'//fmt//'" for read of file "'//file//'" '// &
                    "into complex array. Format must be one of: "//join(REAL_FMTS)
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
      end if

      im_ = optval(im, EMPTY_STRING)

      select rank(into)
        rank(1)
          call from_text(file, into, header_, locale_, delim_, fmt_, im_, stat_, errmsg_, column_names=column_names)
        rank(2)
          call from_text(file, into, header_, locale_, delim_, fmt_, im_, stat_, errmsg_, column_names=column_names)
        rank default
          stat_   = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-2."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
      end select
    else if ( format_of(file, format) == "npy" ) then
      if ( present(column_names) ) then
        stat_   = ARG_ERR
        errmsg_ = 'column_names was given for file "'//file//'", but a .npy file has no header row.'
        call stop_if_unhandled(stat_, errmsg_, present(stat))
        return
      end if

#:if k in QUAD_KINDS
      stat_   = ARG_ERR
      errmsg_ = 'NumPy has no type for real128 data, so "'//file//'" cannot be a .npy file.'
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
#:else
      if ( present(header) ) write(*,"(a)") LF//'WARNING: header not supported for file type "npy".'
#:if not k.startswith("i")
      if ( present(locale) ) write(*,"(a)") LF//'WARNING: locale not supported for file type "npy".'
#:endif
      if ( present(delim ) ) write(*,"(a)") LF//'WARNING: delim not supported for file type "npy".'
      if ( present(fmt   ) ) write(*,"(a)") LF//'WARNING: fmt not supported for file type "npy".'
#:if k.startswith("c")
      if ( present(im    ) ) write(*,"(a)") LF//'WARNING: im not supported for file type "npy".'
#:endif

      select rank(into)
#:for rank in RANKS
        rank(${rank}$); call from_npy(file, into, stat_, errmsg_)
#:endfor
        rank default
          stat_   = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-15."
      end select
#:endif
    else
      stat_   = ARG_ERR
      errmsg_ = 'Unsupported file extension "'//ext//'" for file "'//file//'". Extension must be one of: '// &
                join(TEXT_EXT)//' npy. Or pass format="text" or format="npy".'
    end if

    call stop_if_unhandled(stat_, errmsg_, present(stat))
  end procedure from_textfile_${k}$
#:if k in QUAD_KINDS
#endif
#:endif

#:endfor

#:for k, r in COMPLEX_KINDS
#:if k in QUAD_KINDS
#ifdef IOFL_HAS_R128
#:endif
  module procedure from_binaryfile_${k}$
    character(len=:), allocatable :: ext
    integer                       :: into_rank

    character(len=:), pointer :: errmsg_
    integer, pointer :: stat_

    character(len=1024), target :: dummy_msg
    integer,          target :: dummy_stat

    ext = ext_of(file)

    if ( .not. present(stat) ) then
      stat_ => dummy_stat
    else
      stat_ => stat
    end if

    if ( .not. present(errmsg) ) then
      errmsg_ => dummy_msg
    else
      errmsg_ => errmsg
    end if

    stat_=0; errmsg_=EMPTY_STR

    select rank(into)
#:for rank in RANKS
      rank(${rank}$); into_rank = ${rank}$
#:endfor
      rank default; into_rank = -1
    end select

    if ( size(data_shape) /= into_rank ) then
      stat_   = ARG_ERR
      errmsg_ = "RANK/SHAPE mismatch: size of data_shape must match rank of output array."
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    if ( format_of(file, format) == "npy" ) then
#:if k in QUAD_KINDS
      stat_   = ARG_ERR
      errmsg_ = 'NumPy has no type for real128 data, so "'//file//'" cannot be a .npy file.'
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
#:else
      select rank(into)
#:for rank in RANKS
        rank(${rank}$)
          call from_npy(file, into, stat_, errmsg_)
          if ( stat_ == 0 ) then
            if ( any(shape(into) /= data_shape) ) then
              stat_   = READ_ERR
              errmsg_ = 'Error reading file "'//file//'": its shape differs from data_shape.'
            end if
          end if
#:endfor
      end select
#:endif
    else if ( format_of(file, format) == "binary" ) then
      select rank(into)
#:for rank in RANKS
        rank(${rank}$)
          call from_binary(file, into, data_shape, stat_, errmsg_)
#:endfor
        rank default
          stat_  = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-15."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
      end select
    else
      stat_   = ARG_ERR
      errmsg_ = 'Error reading file "'//file//'" with extension "'//ext//'". '// &
                "If attempting to read a text file, the data_shape argument must not be specified."// &
                "If attempting to read a binary file, the supported file extensions are: "//join(BINARY_EXT)
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    call stop_if_unhandled(stat_, errmsg_, present(stat))
  end procedure from_binaryfile_${k}$
#:if k in QUAD_KINDS
#endif
#:endif

#:endfor

#:for k in REAL_KINDS
#:if k in QUAD_KINDS
#ifdef IOFL_HAS_R128
#:endif
  module procedure from_textfile_${k}$
    character(len=:), allocatable :: ext

    character(len=:), allocatable :: locale_, delim_, fmt_
    character(len=:), pointer :: errmsg_
    logical :: header_
    integer, pointer :: stat_

    character(len=1024), target :: dummy_msg
    integer,          target :: dummy_stat

    ext = ext_of(file)

    if ( .not. present(stat) ) then
      stat_ => dummy_stat
    else
      stat_ => stat
    end if

    if ( .not. present(errmsg) ) then
      errmsg_ => dummy_msg
    else
      errmsg_ => errmsg
    end if

    stat_=0; errmsg_=EMPTY_STR

    if ( format_of(file, format) == "text" ) then
      header_ = optval(header, ABSENT_HEADER)

      if ( present(column_names) ) then
        if ( present(header) .and. (.not. header_) ) then
          stat_   = ARG_ERR
          errmsg_ = 'column_names was given for file "'//file//'" with header=.false.. column_names reads the '// &
                    "header row, so leave header out or set it to .true.."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
        header_ = .true.
      end if

      if ( .not. present(locale) ) then
        locale_ = US_LOCALE
      else
        if ( any(LOCALES == locale) ) then
          locale_ = locale
        else
          stat_   = ARG_ERR
          errmsg_ = 'Invalid locale "'//locale//'" for file "'//file//'". Locale must be one of: '//join(LOCALES)
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
      end if

      if ( .not. present(delim) ) then
        delim_ = default_delim(file, locale_)
      else
        delim_ = delim
        if ( locale_ == US_LOCALE ) then
          if ( delim_ == POINT ) then
            stat_   = ARG_ERR
            errmsg_ = "Invalid delimiter for numbers having US style decimal."
            call stop_if_unhandled(stat_, errmsg_, present(stat))
            return
          end if
        else
          if ( delim_ == COMMA ) then
            stat_   = ARG_ERR
            errmsg_ = "Invalid delimiter for numbers having EU style decimal."
            call stop_if_unhandled(stat_, errmsg_, present(stat))
            return
          end if
        end if
      end if

      if ( .not. present(fmt) ) then
        fmt_ = EXP_FMT
      else
        if ( any(REAL_FMTS == fmt) ) then
          fmt_ = fmt
        else
          stat_   = ARG_ERR
          errmsg_ = 'Invalid format "'//fmt//'" for read of file "'//file//'" '// &
                    "into real array. Format must be one of: "//join(REAL_FMTS)
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
      end if

      select rank(into)
        rank(1)
          call from_text(file, into, header_, locale_, delim_, fmt_, stat_, errmsg_, column_names=column_names)
        rank(2)
          call from_text(file, into, header_, locale_, delim_, fmt_, stat_, errmsg_, column_names=column_names)
        rank default
          stat_   = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-2."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
      end select
    else if ( format_of(file, format) == "npy" ) then
      if ( present(column_names) ) then
        stat_   = ARG_ERR
        errmsg_ = 'column_names was given for file "'//file//'", but a .npy file has no header row.'
        call stop_if_unhandled(stat_, errmsg_, present(stat))
        return
      end if

#:if k in QUAD_KINDS
      stat_   = ARG_ERR
      errmsg_ = 'NumPy has no type for real128 data, so "'//file//'" cannot be a .npy file.'
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
#:else
      if ( present(header) ) write(*,"(a)") LF//'WARNING: header not supported for file type "npy".'
#:if not k.startswith("i")
      if ( present(locale) ) write(*,"(a)") LF//'WARNING: locale not supported for file type "npy".'
#:endif
      if ( present(delim ) ) write(*,"(a)") LF//'WARNING: delim not supported for file type "npy".'
      if ( present(fmt   ) ) write(*,"(a)") LF//'WARNING: fmt not supported for file type "npy".'
#:if k.startswith("c")
      if ( present(im    ) ) write(*,"(a)") LF//'WARNING: im not supported for file type "npy".'
#:endif

      select rank(into)
#:for rank in RANKS
        rank(${rank}$); call from_npy(file, into, stat_, errmsg_)
#:endfor
        rank default
          stat_   = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-15."
      end select
#:endif
    else
      stat_   = ARG_ERR
      errmsg_ = 'Unsupported file extension "'//ext//'" for file "'//file//'". Extension must be one of: '// &
                join(TEXT_EXT)//' npy. Or pass format="text" or format="npy".'
    end if

    call stop_if_unhandled(stat_, errmsg_, present(stat))
  end procedure from_textfile_${k}$
#:if k in QUAD_KINDS
#endif
#:endif

#:endfor

#:for k in REAL_KINDS
#:if k in QUAD_KINDS
#ifdef IOFL_HAS_R128
#:endif
  module procedure from_binaryfile_${k}$
    character(len=:), allocatable :: ext
    integer                       :: into_rank

    character(len=:), pointer :: errmsg_
    integer, pointer :: stat_

    character(len=1024), target :: dummy_msg
    integer,          target :: dummy_stat

    ext = ext_of(file)

    if ( .not. present(stat) ) then
      stat_ => dummy_stat
    else
      stat_ => stat
    end if

    if ( .not. present(errmsg) ) then
      errmsg_ => dummy_msg
    else
      errmsg_ => errmsg
    end if

    stat_=0; errmsg_=EMPTY_STR

    select rank(into)
#:for rank in RANKS
      rank(${rank}$); into_rank = ${rank}$
#:endfor
      rank default; into_rank = -1
    end select

    if ( size(data_shape) /= into_rank ) then
      stat_   = ARG_ERR
      errmsg_ = "RANK/SHAPE mismatch: size of data_shape must match rank of output array."
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    if ( format_of(file, format) == "npy" ) then
#:if k in QUAD_KINDS
      stat_   = ARG_ERR
      errmsg_ = 'NumPy has no type for real128 data, so "'//file//'" cannot be a .npy file.'
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
#:else
      select rank(into)
#:for rank in RANKS
        rank(${rank}$)
          call from_npy(file, into, stat_, errmsg_)
          if ( stat_ == 0 ) then
            if ( any(shape(into) /= data_shape) ) then
              stat_   = READ_ERR
              errmsg_ = 'Error reading file "'//file//'": its shape differs from data_shape.'
            end if
          end if
#:endfor
      end select
#:endif
    else if ( format_of(file, format) == "binary" ) then
      select rank(into)
#:for rank in RANKS
        rank(${rank}$)
          call from_binary(file, into, data_shape, stat_, errmsg_)
#:endfor
        rank default
          stat_  = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-15."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
      end select
    else
      stat_   = ARG_ERR
      errmsg_ = 'Error reading file "'//file//'" with extension "'//ext//'". '// &
                "If attempting to read a text file, the data_shape argument must not be specified."// &
                "If attempting to read a binary file, the supported file extensions are: "//join(BINARY_EXT)
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    call stop_if_unhandled(stat_, errmsg_, present(stat))
  end procedure from_binaryfile_${k}$
#:if k in QUAD_KINDS
#endif
#:endif

#:endfor

#:for k in INT_KINDS
  module procedure from_textfile_${k}$
    character(len=:), allocatable :: ext

    character(len=:), allocatable :: delim_, fmt_
    character(len=:), pointer :: errmsg_
    logical :: header_
    integer, pointer :: stat_

    character(len=1024), target :: dummy_msg
    integer,          target :: dummy_stat

    ext = ext_of(file)

    if ( .not. present(stat) ) then
      stat_ => dummy_stat
    else
      stat_ => stat
    end if

    if ( .not. present(errmsg) ) then
      errmsg_ => dummy_msg
    else
      errmsg_ => errmsg
    end if

    stat_=0; errmsg_=EMPTY_STR

    if ( format_of(file, format) == "text" ) then
      header_ = optval(header, ABSENT_HEADER)

      if ( present(column_names) ) then
        if ( present(header) .and. (.not. header_) ) then
          stat_   = ARG_ERR
          errmsg_ = 'column_names was given for file "'//file//'" with header=.false.. column_names reads the '// &
                    "header row, so leave header out or set it to .true.."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
        header_ = .true.
      end if

      delim_ = optval(delim, default_delim(file, US_LOCALE))

      if ( .not. present(fmt) ) then
        fmt_ = INT_FMT
      else
        if ( any(INT_FMTS == fmt) ) then
          fmt_ = fmt
        else
          stat_   = ARG_ERR
          errmsg_ = 'Invalid format "'//fmt//'" for read of file "'//file//'" '// &
                    "into integer array. Format must be one of: "//join(INT_FMTS)
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
        end if
      end if

      select rank(into)
        rank(1)
          call from_text(file, into, header_, delim_, fmt_, stat_, errmsg_, column_names=column_names)
        rank(2)
          call from_text(file, into, header_, delim_, fmt_, stat_, errmsg_, column_names=column_names)
        rank default
          stat_   = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-2."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
      end select
    else if ( format_of(file, format) == "npy" ) then
      if ( present(column_names) ) then
        stat_   = ARG_ERR
        errmsg_ = 'column_names was given for file "'//file//'", but a .npy file has no header row.'
        call stop_if_unhandled(stat_, errmsg_, present(stat))
        return
      end if

#:if k in QUAD_KINDS
      stat_   = ARG_ERR
      errmsg_ = 'NumPy has no type for real128 data, so "'//file//'" cannot be a .npy file.'
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
#:else
      if ( present(header) ) write(*,"(a)") LF//'WARNING: header not supported for file type "npy".'
#:if not k.startswith("i")
      if ( present(locale) ) write(*,"(a)") LF//'WARNING: locale not supported for file type "npy".'
#:endif
      if ( present(delim ) ) write(*,"(a)") LF//'WARNING: delim not supported for file type "npy".'
      if ( present(fmt   ) ) write(*,"(a)") LF//'WARNING: fmt not supported for file type "npy".'
#:if k.startswith("c")
      if ( present(im    ) ) write(*,"(a)") LF//'WARNING: im not supported for file type "npy".'
#:endif

      select rank(into)
#:for rank in RANKS
        rank(${rank}$); call from_npy(file, into, stat_, errmsg_)
#:endfor
        rank default
          stat_   = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-15."
      end select
#:endif
    else
      stat_   = ARG_ERR
      errmsg_ = 'Unsupported file extension "'//ext//'" for file "'//file//'". Extension must be one of: '// &
                join(TEXT_EXT)//' npy. Or pass format="text" or format="npy".'
    end if

    call stop_if_unhandled(stat_, errmsg_, present(stat))
  end procedure from_textfile_${k}$

#:endfor

#:for k in INT_KINDS
  module procedure from_binaryfile_${k}$
    character(len=:), allocatable :: ext
    integer                       :: into_rank

    character(len=:), pointer :: errmsg_
    integer, pointer :: stat_

    character(len=1024), target :: dummy_msg
    integer,          target :: dummy_stat

    ext = ext_of(file)

    if ( .not. present(stat) ) then
      stat_ => dummy_stat
    else
      stat_ => stat
    end if

    if ( .not. present(errmsg) ) then
      errmsg_ => dummy_msg
    else
      errmsg_ => errmsg
    end if

    stat_=0; errmsg_=EMPTY_STR

    select rank(into)
#:for rank in RANKS
      rank(${rank}$); into_rank = ${rank}$
#:endfor
      rank default; into_rank = -1
    end select

    if ( size(data_shape) /= into_rank ) then
      stat_   = ARG_ERR
      errmsg_ = "RANK/SHAPE mismatch: size of data_shape must match rank of output array."
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    if ( format_of(file, format) == "npy" ) then
#:if k in QUAD_KINDS
      stat_   = ARG_ERR
      errmsg_ = 'NumPy has no type for real128 data, so "'//file//'" cannot be a .npy file.'
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
#:else
      select rank(into)
#:for rank in RANKS
        rank(${rank}$)
          call from_npy(file, into, stat_, errmsg_)
          if ( stat_ == 0 ) then
            if ( any(shape(into) /= data_shape) ) then
              stat_   = READ_ERR
              errmsg_ = 'Error reading file "'//file//'": its shape differs from data_shape.'
            end if
          end if
#:endfor
      end select
#:endif
    else if ( format_of(file, format) == "binary" ) then
      select rank(into)
#:for rank in RANKS
        rank(${rank}$)
          call from_binary(file, into, data_shape, stat_, errmsg_)
#:endfor
        rank default
          stat_  = ARG_ERR
          errmsg_ = "Array has invalid rank. Supported ranks: 1-15."
          call stop_if_unhandled(stat_, errmsg_, present(stat))
          return
      end select
    else
      stat_   = ARG_ERR
      errmsg_ = 'Error reading file "'//file//'" with extension "'//ext//'". '// &
                "If attempting to read a text file, the data_shape argument must not be specified."// &
                "If attempting to read a binary file, the supported file extensions are: "//join(BINARY_EXT)
      call stop_if_unhandled(stat_, errmsg_, present(stat))
      return
    end if

    call stop_if_unhandled(stat_, errmsg_, present(stat))
  end procedure from_binaryfile_${k}$

#:endfor
end submodule io_file
