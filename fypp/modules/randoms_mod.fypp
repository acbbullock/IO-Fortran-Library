#ifdef IOFL_HAS_R128
#:endif
    impure real(${k}$) module function gauss_${k}$(mu, sig) result(gauss_res)
      real(${k}$), intent(in) :: mu, sig
    end function gauss_${k}$
#:if k in QUAD_KINDS
#endif
#:endif

#:endfor
  end interface

