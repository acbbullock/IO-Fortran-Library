#! Definitions shared by the templates. Run fypp/generate.sh after changing any template, and commit the result in src and test.
#:set COMPLEX_KINDS = [("c128", "r128"), ("c64", "r64"), ("c32", "r32")]
#:set REAL_KINDS = ["r128", "r64", "r32"]
#:set INT_KINDS = ["i64", "i32", "i16", "i8"]
#:set QUAD_KINDS = ["c128", "r128"]
#:set RANKS = list(range(1, 16))
#:set E_DECIMALS = {"r128": 35, "r64": 17, "r32": 8}
#:set E_DIGITS = {"r128": 4, "r64": 3, "r32": 2}
#:set F_DIGITS = {"r128": 36, "r64": 18, "r32": 9}
#:set SAME_SIZE_INT = {"r64": "i64", "r32": "i32"}
#:set ORDER_OPERATORS = [("<", "lt", "Less than"), ("<=", "le", "Less than or equal"), (">", "gt", "Greater than"), (">=", "ge", "Greater than or equal")]
#:set ORDER_TESTS = {"lt": "< 0", "le": "<= 0", "gt": "> 0", "ge": ">= 0"}
#! Types that NumPy .npy files support: (kind, declaration, NumPy type code, bytes). NumPy has no IEEE binary128 type.
#:set NPY_TYPES = [("c64", "complex(r64)", "c", 16), ("c32", "complex(r32)", "c", 8), ("r64", "real(r64)", "f", 8), ("r32", "real(r32)", "f", 4), ("i64", "integer(i64)", "i", 8), ("i32", "integer(i32)", "i", 4), ("i16", "integer(i16)", "i", 2), ("i8", "integer(i8)", "i", 1), ("l", "logical", "b", 1)]
